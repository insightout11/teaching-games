# TeachPlay Environment Variables
# Copy this file to .env.local and fill in the values

# Mock Mode - set to "true" to bypass Supabase entirely (for local testing)
# When enabled, the app uses in-memory data with pre-seeded demo class + students
NEXT_PUBLIC_MOCK_MODE=true

# AI Provider Configuration
# AI_PROVIDER: gemini (default) | openai | groq
AI_PROVIDER=gemini

# Gemini API Key (default provider)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API Key (optional, for AI_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Groq API Key (optional, for AI_PROVIDER=groq)
# Get your key from: https://console.groq.com/keys
# GROQ_API_KEY=

# Supabase Configuration (only required when MOCK_MODE is false/unset)
# Get these from your Supabase project settings
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
