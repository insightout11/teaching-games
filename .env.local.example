# TeachPlay Environment Variables
# Copy this file to .env.local and fill in the values

# Mock Mode - set to "true" to bypass Supabase entirely (for local testing)
# When enabled, the app uses in-memory data with pre-seeded demo class + students
NEXT_PUBLIC_MOCK_MODE=true

# Gemini API Key for VocabSprint AI (required for AI features)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Configuration (only required when MOCK_MODE is false/unset)
# Get these from your Supabase project settings
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
