# Normalize line endings to LF in the repo (silences the "LF will be replaced by CRLF" churn).
* text=auto eol=lf

# Treat binary assets as binary so they're never line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.mp4 binary
